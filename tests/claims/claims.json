      "evidence": [
        "contains:tests/contract/contract_test.go::TestJobJSONShape"
      ]
    },
    {
      "id": "external-ytdlp",
      "claim": "Downloads shell out to the external yt-dlp executable.",
      "evidence": [
        "contains:internal/acquisition/ytdlp.go::exec.CommandContext",
        "contains:internal/acquisition/ytdlp.go::--extract-audio"
      ]
    },
    {
      "id": "ffmpeg-checked",
      "claim": "The health check requires ffmpeg on PATH.",
      "evidence": [
        "contains:internal/acquisition/ytdlp.go::exec.LookPath(\"ffmpeg\")",
        "contains:README.md::ffmpeg",
        "contains:internal/acquisition/ytdlp_test.go::TestYtDlpHealthRequiresFfmpeg"
      ]
    },
    {
      "id": "integration-suite",
      "claim": "The runner drains a queue through the real client against a fake core.",
      "evidence": [
        "contains:tests/integration/integration_test.go::TestProvisionerDrainsQueueWithFakeYtDlp"
      ]
    },
    {
      "id": "kill-switch-stops-runner",
      "claim": "The runner stops when a claim is refused by the core kill switch.",
      "evidence": [
        "contains:internal/acquisition/runner.go::ErrStopped",
        "contains:internal/acquisition/client.go::ErrStopped"
      ]
    },
    {
      "id": "matching-low-confidence-review",
      "claim": "A low-confidence match goes to review instead of downloading silently.",
      "evidence": [
        "contains:tests/integration/integration_test.go::TestProvisionerSendsLowConfidenceToReview"
      ]
    },
    {
      "id": "matching-prefers-audio",
      "claim": "Candidate matching prefers audio over video and uploads.",
      "evidence": [
        "contains:internal/acquisition/match_test.go::TestPreferAudioRanksKindsThenConfidence"
      ]
    },
    {
      "id": "no-core-internal-import",
      "claim": "The provisioner never imports a core internal package.",
